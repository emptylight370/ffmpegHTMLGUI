{
  "name": "ffmpeggui-emptylight",
  "version": "1.0.0",
  "description": "A electron app provides interface for ffmpeg",
  "main": "./src/main.js",
  "author": "emptylight",
  "homepage": "https://github.com/emptylight370/ffmpegHTMLGUI",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --ext .js .",
    "dev": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "electron-builder --win --config",
    "build:mac": "electron-builder --mac --config",
    "build:linux": "electron-builder --linux --config"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "electron-updater": "^6.8.3",
    "node-cmd": "^5.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "eslint": "^10.1.0",
    "prettier": "^3.8.1"
  }
}
